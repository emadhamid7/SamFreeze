    <string name="uninstall_confirm_body">This will uninstall the app for the current user. It stays recoverable via reinstall, but this goes further than freezing. Continue?</string>

    <!-- Freeze levels, mirrors UAD-ng's removal-safety categories -->
    <string name="freeze_levels">Freeze Levels</string>
    <string name="level_recommended">Recommended</string>
    <string name="level_recommended_desc">Safe. Widely agreed to be fine to freeze: bloat, duplicate apps, or unused OEM extras.</string>
    <string name="level_advanced">Advanced</string>
    <string name="level_advanced_desc">Mostly safe, but might remove a feature you actually use. Read the description first.</string>
    <string name="level_expert">Expert</string>
    <string name="level_expert_desc">Can break specific features (camera add-ons, carrier services, overlays). Know what you\'re doing.</string>
    <string name="level_unsafe">Unsafe</string>
    <string name="level_unsafe_desc">Core system packages. Freezing these can bootloop or brick your device. Avoid unless you really know why.</string>
